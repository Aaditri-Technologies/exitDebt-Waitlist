# PostgreSQL connection string
DATABASE_URL=postgresql://username@localhost:5432/exitdebt

# Admin secret for /admin/waitlist (minimum 8 characters)
ADMIN_SECRET=your-strong-secret-here

# Session encryption secret (minimum 32 characters)
# Generate with: openssl rand -hex 16
SESSION_SECRET=your-32-character-or-longer-session-secret

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
